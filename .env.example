# =========================================================================
# Variables de entorno - copialas a un archivo llamado .env.local
# =========================================================================

# --- Supabase ---
# La encontrás en: Supabase Dashboard > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# La encontrás en: Supabase Dashboard > Project Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# La encontrás en: Supabase Dashboard > Project Settings > API > Project API keys > service_role
# OJO: ESTA NUNCA VA AL NAVEGADOR. Solo se usa en el backend (server actions, API routes, edge functions).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Mercado Pago ---
# Access token de tu cuenta de MP. Lo conseguís en:
# https://www.mercadopago.com.ar/developers/panel/app
# (Tu app > Credenciales de producción > Access Token)
# Opcionalmente podés dejarlo vacío y cargarlo desde la pantalla de Configuración (queda guardado en DB).
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxx

# ID de la cuenta de MP que recibe los pagos (collector_id).
# Importante para filtrar movimientos que no son de tu papá.
# Lo podés sacar haciendo una primera sincronización y mirando el collector_id de cualquier movimiento entrante.
# Si lo dejás vacío, la primera sincronización lo autodetecta y lo guarda en la tabla `config`.
MP_COLLECTOR_ID=

# --- Seguridad ---
# Clave secreta de 32+ caracteres para encriptar el access token en la DB.
# Generala con: openssl rand -base64 32
ENCRYPTION_KEY=cambialo_por_una_clave_aleatoria_de_32_chars

# Secret para autorizar el cron job que dispara la sincronización (Vercel Cron + Edge Function).
# Generala con: openssl rand -base64 32
CRON_SECRET=cambialo_por_un_secret_aleatorio
